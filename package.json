{
  "name": "orochia-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@krizaka/app-config": "^0.2.0",
    "@krizaka/charts": "^0.5.0",
    "@krizaka/discovery": "^0.1.0",
    "@krizaka/i18n": "^0.2.2",
    "@krizaka/orochia-design-system": "^4.1.1",
    "@krizaka/pacer": "^0.1.0",
    "@krizaka/tokens": "^3.28.0",
    "@krizaka/ui": "^3.28.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.58.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint && npm run check:i18n",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:app-links": "node scripts/check-app-links.mjs",
    "check": "npm run lint && npm run check:app-links && npm run typecheck && npm test && npm run export",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "doctor": "expo-doctor",
    "check:i18n": "krizaka-i18n check src/i18n && krizaka-i18n scan src/app src/components src/lib --skip __tests__ --skip __fixtures__ --allow Orochia"
  },
  "private": true,
  "description": "Orochia for iOS and Android — the creator video platform, in your pocket. React Native (Expo).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/orochia-mobile.git"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@krizaka|@noble|@tanstack))"
    ],
    "moduleNameMapper": {
      "^@krizaka/ui/native$": "<rootDir>/node_modules/@krizaka/ui/dist/native.js",
      "^@krizaka/tokens/native$": "<rootDir>/node_modules/@krizaka/tokens/dist/native.js",
      "^@krizaka/orochia-design-system/tokens$": "<rootDir>/node_modules/@krizaka/orochia-design-system/dist/tokens.js",
      "^@krizaka/charts/native$": "<rootDir>/node_modules/@krizaka/charts/dist/native.js",
      "^@krizaka/intl$": "<rootDir>/node_modules/@krizaka/intl/dist/index.js",
      "^@krizaka/pacer/react$": "<rootDir>/node_modules/@krizaka/pacer/dist/react.js",
      "^@krizaka/pacer$": "<rootDir>/node_modules/@krizaka/pacer/dist/index.js",
      "^@krizaka/discovery/react$": "<rootDir>/node_modules/@krizaka/discovery/dist/react.js",
      "^@krizaka/discovery/sign$": "<rootDir>/node_modules/@krizaka/discovery/dist/sign.js",
      "^@krizaka/discovery$": "<rootDir>/node_modules/@krizaka/discovery/dist/index.js",
      "^@krizaka/app-config/client$": "<rootDir>/node_modules/@krizaka/app-config/dist/client.js",
      "^@krizaka/app-config/react$": "<rootDir>/node_modules/@krizaka/app-config/dist/react.js",
      "^@krizaka/app-config/server$": "<rootDir>/node_modules/@krizaka/app-config/dist/server.js",
      "^@krizaka/app-config$": "<rootDir>/node_modules/@krizaka/app-config/dist/index.js",
      "^@krizaka/i18n$": "<rootDir>/node_modules/@krizaka/i18n/dist/index.js",
      "^@krizaka/intl/plural$": "<rootDir>/node_modules/@krizaka/intl/dist/plural.js"
    }
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1",
    "@krizaka/i18n": {
      "typescript": "$typescript"
    }
  }
}
