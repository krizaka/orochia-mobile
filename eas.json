{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://dev.orochia.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://dev.orochia.com"
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
