{
  "expo": {
    "name": "Orochia",
    "slug": "orochia",
    "owner": "oussamaabid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krizaka.orochia",
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:dev.orochia.com"
      ]
    },
    "android": {
      "package": "com.krizaka.orochia",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "pathPrefix": "/@"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "pathPrefix": "/watch/"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "path": "/me"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "pathPrefix": "/me/"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "path": "/auctions"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "pathPrefix": "/auctions/"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "path": "/challenges"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "pathPrefix": "/challenges/"
            },
            {
              "scheme": "https",
              "host": "dev.orochia.com",
              "path": "/messages"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#09090b"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#a855f7",
          "defaultChannel": "default"
        }
      ],
      "./plugins/with-scene-lifecycle"
    ],
    "scheme": "orochia",
    "backgroundColor": "#09090b",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4862d613-fa21-4d43-9b5d-85ec96818187"
      }
    }
  }
}
